# Copy to .env.local. Never prefix secrets with VITE_.

# Already used by Explore:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Groq (OpenAI-compatible). Required for /api/chat.
# https://console.groq.com/keys — set the same vars on Vercel (Production + Preview).
# Do not prefix GROQ_API_KEY with VITE_.
GROQ_API_KEY=
# Optional default if the client does not send a model:
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Allowlisted models (same Groq free-tier daily cap): qwen/qwen3.6-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
# Optional: Firecrawl search (recommended). DuckDuckGo HTML search is blocked for servers.
# https://www.firecrawl.dev - set the same var on Vercel. Do not prefix with VITE_.
# FIRECRAWL_API_KEY=fc-

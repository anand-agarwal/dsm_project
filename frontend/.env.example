# Copy to .env.local. Never prefix secrets with VITE_.

# Already used by Explore:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Hugging Face Inference Providers (OpenAI-compatible router). Required for /api/chat.
# On Vercel, set these as project env vars (Production + Preview). Do not prefix HF_TOKEN with VITE_.
HF_TOKEN=
# Optional overrides:
# HF_BASE_URL=https://router.huggingface.co/v1
# Optional: Firecrawl search (recommended). DuckDuckGo HTML search is blocked for servers.
# https://www.firecrawl.dev - set the same var on Vercel. Do not prefix with VITE_.
# FIRECRAWL_API_KEY=fc-

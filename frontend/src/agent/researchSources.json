{
  "version": 1,
  "searchBackend": "duckduckgo-search",
  "notes": [
    "Do not use the Wikipedia API or wikipedia.org results.",
    "Issue one DuckDuckGo query, then keep hits whose host matches allowedHosts (suffix match).",
    "Optionally append a site: clause for a single domain when the question is clearly legal vs statistical vs UN.",
    "Census numbers still come from run_census_query, not from these pages."
  ],
  "deniedHosts": [
    "wikipedia.org",
    "m.wikipedia.org",
    "wikiwand.com",
    "wikimedia.org",
    "quora.com",
    "reddit.com",
    "medium.com",
    "facebook.com",
    "x.com",
    "twitter.com",
    "youtube.com"
  ],
